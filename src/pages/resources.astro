---
import Base from '../layouts/Base.astro';
import ResourcesHub from '../components/ResourcesHub.svelte';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Official Resources & Study Links - AI-901 Exam Prep"
  description="All official Microsoft documentation, Microsoft Foundry portals, study guides, official practice tests, and GitHub labs for Microsoft Exam AI-901."
  active="resources"
>
  <div class="wrap">
    <ResourcesHub client:only="svelte" base={base} />
  </div>
</Base>
