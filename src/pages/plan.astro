---
import Base from '../layouts/Base.astro';
import StudyPlan from '../components/StudyPlan.svelte';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Study plan — AI-901 Exam Prep"
  description="A three-day sprint plan for Exam AI-901, front-loaded with the heaviest-weighted topics."
  active="plan"
>
  <div class="wrap">
    <StudyPlan client:only="svelte" base={base} />
  </div>
</Base>
