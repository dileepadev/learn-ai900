---
import Base from '../layouts/Base.astro';
import ProgressReport from '../components/ProgressReport.svelte';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Your progress - AI-901 Exam Prep"
  description="Readiness breakdown, retention schedule, milestones and data controls."
  active="progress"
>
  <div class="wrap">
    <ProgressReport client:only="svelte" base={base} />
  </div>
</Base>
