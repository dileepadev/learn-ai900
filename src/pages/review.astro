---
import Base from '../layouts/Base.astro';
import RapidReview from '../components/RapidReview.svelte';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Rapid review — AI-901 Exam Prep"
  description="Flashcards, service comparisons and know-this facts for Exam AI-901."
  active="review"
>
  <div class="wrap">
    <RapidReview client:only="svelte" base={base} />
  </div>
</Base>
