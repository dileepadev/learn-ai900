---
import Base from '../../layouts/Base.astro';
import PracticeHub from '../../components/PracticeHub.svelte';

const base = import.meta.env.BASE_URL;
---

<Base
  title="Practice - AI-901 Exam Prep"
  description="Spaced-repetition practice for Exam AI-901: mixed sets, rapid fire, weak areas and your past mistakes."
  active="practice"
>
  <div class="wrap">
    <PracticeHub client:only="svelte" base={base} />
  </div>
</Base>
