---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, '')}${p}`;
---

<Base title="Not found - AI-901 Exam Prep">
  <div class="wrap prose" style="text-align:center; padding: 3rem 0;">
    <h1>That page doesn't exist</h1>
    <p class="muted">Let's get you back to studying.</p>
    <div class="row" style="justify-content: center;">
      <a class="btn btn-primary" href={href('/')}>Dashboard</a>
      <a class="btn" href={href('/learn/')}>Lessons</a>
      <a class="btn" href={href('/practice/')}>Practice</a>
    </div>
  </div>
</Base>
